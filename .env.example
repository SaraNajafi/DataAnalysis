# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. On Supabase use the *pooled* connection string
# (Transaction mode, port 6543) for the app running on Vercel.
DATABASE_URL=
# Optional: direct (non-pooled, port 5432) connection used by `npm run db:migrate`.
DATABASE_URL_DIRECT=
# Optional: max connections per server instance (default 5).
DATABASE_POOL_MAX=

# ─── Security ────────────────────────────────────────────────────────────────
# Random string, at least 32 characters (e.g. `openssl rand -base64 48`).
# Used to HMAC OTP codes and IP addresses. Required in production.
SESSION_SECRET=

# ─── SMS / OTP ───────────────────────────────────────────────────────────────
# mock      → development only: prints the OTP to the server console (refuses to run in production)
# kavenegar → Kavenegar API (set SMS_API_KEY and SMS_TEMPLATE or SMS_SENDER)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER=
# Kavenegar "Verify Lookup" template name (template text must contain %token)
SMS_TEMPLATE=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=
# Time zone used to decide "today" (due today / overdue). Default: Asia/Tehran
APP_TIMEZONE=Asia/Tehran
# Comma-separated mobile numbers allowed to open /admin (aggregate pilot metrics)
ADMIN_PHONE_NUMBERS=
